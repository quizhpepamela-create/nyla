generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ENTREPRENEUR
  ADMIN
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  role                 UserRole
  isActive             Boolean   @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  resetTokenHash       String?
  resetTokenExpiresAt  DateTime?

  stripeAccountId          String?
  stripeOnboardingComplete Boolean @default(false)

  studentProfile       StudentProfile?
  entrepreneurProfile  EntrepreneurProfile?

  entrepreneurProjects Project[]     @relation("EntrepreneurProjects")
  assignedProjects     Project[]     @relation("StudentProjects")
  applications         Application[]

  sentMessages         Message[]     @relation("SentMessages")
  receivedMessages     Message[]     @relation("ReceivedMessages")
}

model StudentProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName      String
  photoUrl      String?
  university    String?
  career        String?
  semester      String?
  skills        String[] @default([])
  experience    String?
  portfolioUrl  String?
  cvUrl         String?
  availability  String?
  rating        Float?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EntrepreneurProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName           String
  logoUrl                String?
  category               String?
  description            String?
  objectives             String?
  projectNeeds           String?
  studentProfileSought   String?
  requiredSkills         String[] @default([])
  estimatedDuration      String?
  budgetOrHours          String?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum EscrowStatus {
  NONE
  HELD
  RELEASED
}

model Project {
  id                String        @id @default(cuid())
  entrepreneurId    String
  entrepreneur      User          @relation("EntrepreneurProjects", fields: [entrepreneurId], references: [id])
  studentId         String?
  student           User?         @relation("StudentProjects", fields: [studentId], references: [id])

  title             String
  description       String
  requiredCareer    String?
  requiredSkills    String[]      @default([])
  estimatedHours    Int
  hourlyRate        Float
  budget            Float
  status            ProjectStatus @default(OPEN)
  escrowStatus      EscrowStatus  @default(NONE)
  progress          Int           @default(0)
  deliverables      String[]      @default([])
  startDate         DateTime?
  endDate           DateTime?

  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  stripeTransferId        String?

  applications      Application[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Application {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  studentId     String
  student       User              @relation(fields: [studentId], references: [id])
  proposedHours Int?
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime          @default(now())

  @@unique([projectId, studentId])
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  recipientId String
  recipient   User     @relation("ReceivedMessages", fields: [recipientId], references: [id])
  content     String
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([senderId, recipientId])
  @@index([recipientId, senderId])
}
